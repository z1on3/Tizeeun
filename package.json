{
  "name": "tizeeun",
  "version": "0.2.0",
  "description": "TV-first streaming aggregator for TizenBrew. Catalog from TMDB, playback from your media servers plus frameXTV online streams.",
  "packageType": "app",
  "appName": "Tizeeun",
  "appPath": "app/index.html",
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue"
  ],
  "evaluateScriptOnDocumentStart": false,
  "files": [
    "app/"
  ],
  "scripts": {
    "predev": "node dev/build-config.js",
    "dev": "npx --yes http-server app -p 8080 -c-1",
    "config": "node dev/build-config.js"
  },
  "keywords": [
    "tizenbrew",
    "tizen",
    "samsung",
    "tv",
    "jellyfin",
    "tmdb",
    "framextv"
  ],
  "license": "MIT"
}
